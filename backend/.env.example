# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่อง  ->  cp .env.example .env
# PostgreSQL 14 ใน WSL Ubuntu — role naemsupawat เป็น superuser อยู่แล้ว
DATABASE_URL=postgresql+psycopg://naemsupawat:hotline@127.0.0.1:5432/hotline
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=480
# ต้องใส่ทั้ง localhost และ 127.0.0.1 — เบราว์เซอร์ถือว่าเป็นคนละ origin
# ถ้าขาด 127.0.0.1 คนที่เปิดเว็บด้วยเลข IP จะสมัคร/ล็อกอินไม่ได้
# และเห็นข้อความ "เชื่อมต่อระบบไม่ได้" ทั้งที่เซิร์ฟเวอร์ทำงานปกติ
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
